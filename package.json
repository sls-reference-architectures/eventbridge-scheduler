{
  "name": "eventbridge-scheduler",
  "version": "1.0.0",
  "description": "A service based on EventBridge's Scheduler",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint '**.*.js' --fix",
    "test": "npm run test:unit",
    "test:int": "npx jest --config jest.config.int.js",
    "test:unit": "POWERTOOLS_DEV=true POWERTOOLS_LOGGER_SAMPLE_RATE=1 npx jest",
    "deploy": "npx sls deploy",
    "teardown": "npx sls remove",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sls-reference-architectures/eventbridge-scheduler.git"
  },
  "author": "Seth Orell",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sls-reference-architectures/eventbridge-scheduler/issues"
  },
  "homepage": "https://github.com/sls-reference-architectures/eventbridge-scheduler#readme",
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1090.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.9.0",
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "async-retry": "^1.3.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "lint-staged": "^17.1.1",
    "osls": "^4.0.0",
    "prettier": "^3.9.6",
    "serverless-esbuild": "^1.57.2"
  },
  "lint-staged": {
    "*.{js, mjs}": "eslint --cache --fix",
    "*.{js,md,mjs,yml,json}": "npx prettier . --write --ignore-path .gitignore"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.34.0",
    "@aws-sdk/client-eventbridge": "^3.1101.0",
    "@aws-sdk/client-scheduler": "^3.1097.0",
    "@middy/core": "^7.7.2",
    "http-errors": "^2.0.1",
    "ulid": "^3.0.2"
